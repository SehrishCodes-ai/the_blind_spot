# The Blind Spot - Environment Configuration
# Copy this file to .env and insert your Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Host and Port settings (defaults to 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000

# Google Gemini Model configuration
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
